APP_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional operator identity for legacy data and owner-only email notifications.
GOOGLE_OWNER_EMAIL=
GOOGLE_OWNER_SUB=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
GMAIL_APP_PASSWORD=

# Stock alerts are independent of existing portfolio Blob storage.
# Runtime: pooled PostgreSQL URL with TLS. Migration: direct URL with TLS.
ALERT_DATABASE_URL=
ALERT_MIGRATION_DATABASE_URL=
TWELVE_DATA_API_KEY=
# Use the contracted, endpoint-weighted quota; a complete fetch costs 21 credits.
TWELVE_DATA_CREDITS_PER_MINUTE=
# Optional US earnings/dividend calendar contract, including removed events.
BENZINGA_API_KEY=
BENZINGA_REQUESTS_PER_MINUTE=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# A separate random secret, at least 32 characters.
ALERT_UNSUBSCRIBE_SECRET=
# Enable only after migration, feed licensing/coverage, mail domain and webhook checks.
STOCK_ALERTS_SEND_ENABLED=false
# Isolated integration database only; never point at production.
ALERT_TEST_DATABASE_URL=
